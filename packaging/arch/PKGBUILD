# Maintainer: Marek Samec <marek@samec.me>
#
# Versioned (release) PKGBUILD. Unlike packaging/aur/nvbeam-git, this builds a
# specific tagged release from its GitHub source archive. `pkgver` below is a
# placeholder overwritten by the CI release workflow from the git tag.
pkgname=nvbeam
pkgver=0.0.0
pkgrel=1
pkgdesc="Fast, native Neovim GUI client built with Qt6 and C++"
arch=('x86_64')
url="https://github.com/mareksamec/nvbeam"
license=('MIT')
depends=(
    'qt6-base'
    'qtermwidget'
    'syntax-highlighting'
    'neovim>=0.10'
    'hicolor-icon-theme'
)
makedepends=(
    'cmake'
)
provides=("${pkgname}=${pkgver}")
conflicts=("${pkgname}-git")
options=('!lto')

# makepkg forbids hyphens in pkgver, so a pre-release tag is carried as
# "0.2.0_rc1" here while the tag itself reads "v0.2.0-rc1". _tag maps it back,
# and _srcdir is the directory name GitHub's archive unpacks to.
_tag="v${pkgver//_/-}"
_srcdir="${pkgname}-${_tag#v}"

# Vendor toml11 v4.2.0 so the build is hermetic (no network in build()).
# build() hands the extracted source to FetchContent instead of letting it clone.
_toml11_ver=4.2.0
_toml11_sha256=9287971cd4a1a3992ef37e7b95a3972d1ae56410e7f8e3f300727ab1d6c79c2c

# The release tarball is GitHub's archive of the tag. Its checksum is not known
# until the tag exists, so the release workflow runs `updpkgsums` to fill the
# entry in before building; a hand build of a published tag can do the same.
source=(
    "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz"
    "toml11-${_toml11_ver}.tar.gz::https://github.com/ToruNiina/toml11/archive/refs/tags/v${_toml11_ver}.tar.gz"
)
sha256sums=(
    'SKIP'
    "${_toml11_sha256}"
)

build() {
    cd "${srcdir}/${_srcdir}"
    # FETCHCONTENT_SOURCE_DIR_TOML11 makes FetchContent use the vendored
    # toml11 checkout instead of cloning it.
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DFETCHCONTENT_SOURCE_DIR_TOML11="${srcdir}/toml11-${_toml11_ver}" \
        -DNVBEAM_TERMINAL=ON \
        -DNVBEAM_SYNTAX=ON \
        -Wno-dev
    cmake --build build -j"$(nproc)"
}

package() {
    cd "${srcdir}/${_srcdir}"
    DESTDIR="${pkgdir}" cmake --install build

    # MIT license: AUR/namcap expects it under /usr/share/licenses/<pkg>/
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
