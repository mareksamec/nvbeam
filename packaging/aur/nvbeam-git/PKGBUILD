# Maintainer: Marek Samec <samec.marek@gmail.com>
pkgname=nvbeam-git
_pkgname=nvbeam
pkgver=r0.cf5f03b
pkgrel=1
pkgdesc="Fast, native Neovim GUI client built with Qt6 and C++ (git)"
arch=('x86_64')
url="https://github.com/mareksamec/nvbeam"
license=('MIT')
depends=(
    'qt6-base'
    'qtermwidget'
    'syntax-highlighting'
    'neovim>=0.10'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'cmake'
    'gcc'
)
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
options=('!lto')

# Vendor toml11 v4.2.0 so the build is hermetic (no network in build()).
# Upstream CMake uses FetchContent_Declare(toml11 ...); prepare() rewrites
# that to point at the locally extracted source.
_toml11_ver=4.2.0
_toml11_sha256=9287971cd4a1a3992ef37e7b95a3972d1ae56410e7f8e3f300727ab1d6c79c2c

source=(
    "${_pkgname}::git+${url}.git"
    "toml11-${_toml11_ver}.tar.gz::https://github.com/ToruNiina/toml11/archive/refs/tags/v${_toml11_ver}.tar.gz"
)
sha256sums=(
    'SKIP'
    "${_toml11_sha256}"
)

pkgver() {
    cd "${srcdir}/${_pkgname}"
    # Produces:
    #   <tag>.r<commits-since-tag>.<short-sha>  if any tag exists
    #   r<total-commits>.<short-sha>            otherwise
    (
        git describe --long --tags 2>/dev/null \
            | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    ) || printf 'r%s.%s' \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${_pkgname}"

    # Point FetchContent at the local extracted toml11 instead of cloning.
    # Replaces the GIT_REPOSITORY/GIT_TAG/GIT_SHALLOW block with SOURCE_DIR.
    local _toml11_dir="${srcdir}/toml11-${_toml11_ver}"
    if [[ ! -d "${_toml11_dir}" ]]; then
        echo "error: vendored toml11 not found at ${_toml11_dir}" >&2
        return 1
    fi

    # Use a Python one-liner for a precise multi-line replacement — sed across
    # multiple lines with mixed whitespace is fragile.
    python3 - "$_toml11_dir" <<'PY'
import pathlib, re, sys
toml11_dir = sys.argv[1]
p = pathlib.Path("CMakeLists.txt")
text = p.read_text()
new_block = (
    "FetchContent_Declare(\n"
    "    toml11\n"
    f"    SOURCE_DIR     {toml11_dir}\n"
    ")"
)
text, n = re.subn(
    r"FetchContent_Declare\(\s*toml11.*?\)",
    new_block,
    text,
    count=1,
    flags=re.DOTALL,
)
if n != 1:
    sys.exit("FetchContent_Declare(toml11 ...) block not found")
p.write_text(text)
PY
}

build() {
    cd "${srcdir}/${_pkgname}"
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DNVBEAM_TERMINAL=ON \
        -DNVBEAM_SYNTAX=ON \
        -Wno-dev
    cmake --build build -j"$(nproc)"
}

package() {
    cd "${srcdir}/${_pkgname}"
    DESTDIR="${pkgdir}" cmake --install build

    # MIT license: AUR/namcap expects it under /usr/share/licenses/<pkg>/
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
